# Non-secret host configuration for the independent ZhiCe Ops service.
ZHICE_OPS_PORT=7681
ZHICE_OPS_TERMINAL_PORT=7682
ZHICE_OPS_DASHBOARD_PORT=7683
ZHICE_OPS_IDLE_TIMEOUT_SECONDS=900
ZHICE_OPS_CREDENTIAL=owner:REPLACE_WITH_SERVER_GENERATED_SECRET
ZHICE_OPS_CADDY_HASH=SERVER_GENERATED_BCRYPT_HASH
ZHICE_OPS_ALLOWED_ORIGIN=https://public.example.invalid
ZHICE_PUBLIC_URL=https://public.example.invalid
ZHICE_PUBLIC_HEALTH_URL=https://public.example.invalid/health
ZHICE_OPS_PUBLIC_URL=https://ops.example.invalid
