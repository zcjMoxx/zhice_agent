{
  "mcpServers": {
    "example_stdio": {
      "command": "python",
      "args": ["path/to/server.py"],
      "env": {
        "EXAMPLE_TOKEN": "${EXAMPLE_MCP_TOKEN}"
      },
      "call_timeout_seconds": 60
    },
    "example_http": {
      "url": "https://example.invalid/mcp",
      "transport": "streamable_http",
      "headers": {
        "Authorization": "Bearer ${EXAMPLE_MCP_TOKEN}"
      }
    }
  }
}
