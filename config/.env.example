# 公共运行环境模板。`zcagent init` 默认复制到 ~/.zhice/config/.env。
# 所有真实凭据只能写入运行工作区或 deploy/private，不得提交到仓库。

# 模型与向量凭据。与 models.example.json 的环境变量引用保持一致。
ZHICE_LLM_DEEPSEEK_API_KEY=
ZHICE_EMBEDDING_API_KEY=

# Web Owner 初始化与云部署核心验收。
# 烟测账号必须是管理员预先创建的低权限 viewer，禁止复用 Owner/Admin 凭据。
ZHICE_AGENT_SETUP_TOKEN=
ZHICE_DEPLOY_SMOKE_USERNAME=
ZHICE_DEPLOY_SMOKE_PASSWORD=
# 可选：本地 Skill source 仓库路径；留空使用随包提供的 skill_repo。
ZHICE_AGENT_SKILL_REPO=

# 工作流“连接与账号”凭据加密主密钥。
# 使用32字节 URL-safe Base64，生成后必须长期保存；丢失后已有连接无法解密。
ZHICE_AGENT_CREDENTIAL_ENCRYPTION_KEY=

# QQ渠道凭据。
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# 智能旅行外部数据源。
AMAP_MAPS_API_KEY=
TAVILY_API_KEY=

# 小红书只读 sidecar。
# 本地填写 loopback地址和本机 Cookie路径；云端填写容器 DNS与容器内路径。
# 本地默认仅允许回环地址；容器部署应改为可信的容器 DNS 主机名。
XHS_READONLY_UPSTREAM_URL=
XHS_READONLY_HTTP_HOST_ALLOWLIST=127.0.0.1
XHS_READONLY_COOKIE_DIR=
XHS_READONLY_COOKIE_FILE=

# 高德 Web（JS API）前端构建字段，会进入私有前端构建产物。
VITE_AMAP_JS_API_KEY=
VITE_AMAP_JS_SECURITY_CODE=

# 携程只读酒店数据源。
ZHICE_CTRIP_USERNAME=
ZHICE_CTRIP_PASSWORD=

# 平台官方 SMTP。个人 SMTP由用户在页面内配置，不使用这些字段。
ZHICE_SMTP_HOST=
ZHICE_SMTP_PORT=
ZHICE_SMTP_USERNAME=
ZHICE_SMTP_PASSWORD=
ZHICE_SMTP_FROM=

# 本地开发代理。云端保持为空，避免把本机代理地址带入服务器。
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
