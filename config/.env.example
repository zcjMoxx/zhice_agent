# Public runtime environment template.
# `zcagent init` copies this file to ~/.zhice/config/.env by default.
# Choose another workspace with --workspace or a process-level ZHICE_AGENT_WORKSPACE;
# the runtime .env itself intentionally does not define the workspace.

# Chat and embedding credentials referenced by config/models.json.
ZHICE_LLM_OPENAI_API_KEY=
ZHICE_EMBEDDING_API_KEY=

# One-time Web Owner setup credential. Set a strong random value before bootstrap.
ZHICE_AGENT_SETUP_TOKEN=

# Optional QQ channel credentials referenced by config/config.yml.
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# Optional local Skill source repo override. Omit or leave empty to use packaged skill_repo/.
# ZHICE_AGENT_SKILL_REPO=

# Optional intelligent-travel external sources. Keep real values only in the
# runtime workspace config/.env or the deployment Secret mechanism.
AMAP_MAPS_API_KEY=
# A separate AMap Web (JS API) application is required for the browser map.
# These values are embedded into the private frontend build; never commit real values.
VITE_AMAP_JS_API_KEY=
VITE_AMAP_JS_SECURITY_CODE=
TAVILY_API_KEY=
XHS_READONLY_UPSTREAM_URL=
XHS_READONLY_COOKIE_DIR=
XHS_READONLY_COOKIE_FILE=
# Required only when a trusted private container DNS name uses plaintext HTTP.
# XHS_READONLY_HTTP_HOST_ALLOWLIST=zhice-xhs-readonly
# Optional adapter-to-upstream Authorization header; never put it in config.yml.
XHS_READONLY_UPSTREAM_AUTHORIZATION=
